# ============================================================
# .env.test — Configuration pour les tests d'intégration
# Copier ce fichier en .env.test et remplir les valeurs.
# NE JAMAIS committer .env.test (ajouté dans .gitignore).
# ============================================================

# Base de données de TEST — séparée de la prod
# Recommandé : créer une DB dédiée "teamoff_test"
#   psql -c "CREATE DATABASE teamoff_test;"
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/teamoff_test

# JWT — peut être la même clé qu'en dev pour les tests
JWT_SECRET=test_jwt_secret_change_me_in_production

# Email — désactivé en test (les mails ne sont pas envoyés)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=test
EMAIL_PASS=test
EMAIL_FROM=noreply@test.local

# Désactiver les logs en test
LOG_LEVEL=silent

NODE_ENV=test
